{
  "name": "anvesh-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Anvesh API — Express + MongoDB (Mongoose) server.",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "migrate-mongo up -f migrate-mongo-config.js",
    "db:migrate:down": "migrate-mongo down -f migrate-mongo-config.js",
    "db:status": "migrate-mongo status -f migrate-mongo-config.js",
    "db:seed": "tsx src/lib/database/seed/run.ts",
    "db:reset": "tsx src/lib/database/seed/reset.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "openapi": "tsx src/openapi/emit.ts"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.4",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "migrate-mongo": "14.0.7",
    "mongoose": "8.24.4",
    "nodemailer": "7.0.10",
    "otplib": "12.0.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "rate-limiter-flexible": "11.2.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.4.3",
    "typescript": "5.9.3",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.13.0",
    "@types/nodemailer": "7.0.4",
    "@types/swagger-ui-express": "4.1.8"
  },
  "devDependencies": {
    "@types/supertest": "6.0.3",
    "mongodb-memory-server": "10.4.3",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "vitest": "3.2.7"
  }
}