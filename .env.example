# ---------------------------------------------------------------------------
# Anvesh backend — environment template.
#
# Copy this file to .env and fill it in:      cp .env.example .env
# Never commit a filled-in .env.
#
# Every variable is validated at boot by src/lib/config. A missing or malformed
# value stops the server with a readable message instead of failing later.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- URLs -------------------------------------------------------------------
API_PORT=4000
API_BASE_URL=http://localhost:4000

# The React app. All three portals live in it: / for travellers,
# /guide for tourist guides, /admin for staff.
WEB_APP_URL=http://localhost:5173
GUIDE_APP_URL=http://localhost:5173/guide
ADMIN_APP_URL=http://localhost:5173/admin

# Browsers may call the API only from these origins.
# 5173 is `npm run dev` in the frontend, 4173 is `npm run preview`.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- MongoDB ----------------------------------------------------------------
# Easiest option: a free MongoDB Atlas cluster (cloud, nothing to install).
# Paste the connection string it gives you:
#   MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/anvesh
#
# Local MongoDB also works:
#   MONGODB_URI=mongodb://127.0.0.1:27017/anvesh
#
# Note: booking and payment use multi-document transactions, which need a
# replica set. Atlas is one by default. A plain local mongod is not, and the
# server will say so at startup — everything still runs, those two flows just
# lose their all-or-nothing guarantee.
MONGODB_URI=mongodb://127.0.0.1:27017/anvesh
MONGODB_DB_NAME=anvesh

# --- Auth -------------------------------------------------------------------
# Generate each of these with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change_me_to_a_long_random_value_at_least_32_chars
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_value_32_chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=anvesh
JWT_AUDIENCE=anvesh:api
# Encrypts admin TOTP secrets at rest. Rotating this invalidates enrolled TOTP.
TOTP_ENCRYPTION_KEY=change_me_to_a_long_random_value_at_least_32_chars
TOTP_ISSUER=Anvesh Admin
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFICATION_TTL_HOURS=48
ADMIN_INVITE_TTL_HOURS=72
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- Commerce ---------------------------------------------------------------
# Platform commission in basis points. 1200 = 12.00%.
PLATFORM_COMMISSION_BPS=1200
# How long an unpaid booking holds its seats before expiring.
BOOKING_HOLD_MINUTES=15

# --- Razorpay ---------------------------------------------------------------
# Leave blank and the payment endpoints return PAYMENT_PROVIDER_NOT_CONFIGURED.
# They never fake a successful payment. Test keys start with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- AI (Gemini) ------------------------------------------------------------
# AI_PROVIDER=stub is the local provider: deterministic, no API key, and it can
# only ever return places that actually exist in your database. Every stub
# response is labelled provider:"stub" in the API and in the UI.
# Switch to gemini and add a key for the real thing.
AI_PROVIDER=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AI_MONTHLY_REQUEST_LIMIT=200

# --- Maps -------------------------------------------------------------------
# MAPS_PROVIDER=maplibre-demo draws OpenStreetMap tiles and needs no key —
# good enough for development. Use ola with a key for the production map.
MAPS_PROVIDER=maplibre-demo
OLA_MAPS_API_KEY=
OLA_MAPS_BASE_URL=https://api.olamaps.io

# --- Email ------------------------------------------------------------------
# console  = print the email to the server log, send nothing (default)
# smtp     = send through the SMTP server below
# resend   = send through the Resend API (needs RESEND_API_KEY)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Anvesh <hello@anvesh.travel>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# --- Uploads ----------------------------------------------------------------
# Images are written here and served back from http://localhost:4000/uploads/...
# The path is relative to this backend folder.
UPLOAD_DIR=uploads

# --- Limits -----------------------------------------------------------------
RATE_LIMIT_ENABLED=true
BODY_LIMIT=256kb
TRUST_PROXY=false
